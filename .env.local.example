# Google AI Studio key. It is held server-side and only the Gemma 4 ids
# whitelisted in lib/llm/gemma.ts can be selected.
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional non-generative web retrieval for Research mode.
TAVILY_API_KEY=

# Retrieval (lib/rag). Embeddings reuse GEMMA_API_KEY - an embedding model is
# a non-generative retriever, Gemma 4 is still the only model that writes text.
# Set RAG_EMBEDDINGS=off to fall back to BM25-only retrieval.
RAG_EMBEDDINGS=
# Embedding model + truncated dimensionality. Changing either invalidates the
# stored vectors: re-run `npm run rag:ingest -- --force` afterwards.
RAG_EMBED_MODEL=gemini-embedding-001
RAG_EMBED_DIM=768
# Set to "off" to skip the Gemma call that rewrites follow-up questions into
# standalone retrieval queries.
RAG_QUERY_REWRITE=
# Weight of the dense rank list against the lexical one during fusion.
# Retune with `npm run rag:eval` if you change the corpus or the embedder.
RAG_VECTOR_WEIGHT=1.6
# LLM reranking of retrieved passages. Costs one extra model call per turn, so
# it is off unless `npm run rag:eval -- --rerank` shows it earns that latency.
RAG_RERANK=
# Set to "off" to disable the second retrieval pass. It fires when the first
# pass returns too little, or when its best passage scores below the
# similarity threshold below - i.e. when retrieval found nothing relevant.
RAG_SECOND_PASS=
RAG_SECOND_PASS_THRESHOLD=0.6
# Requests-per-minute budget for the batch eval harnesses only. Production
# request paths are never queued - they fail fast or fall back instead.
RAG_EVAL_RPM=12

# MongoDB connection string. The public /demo route works without MongoDB;
# authenticated workspace features require it.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# ─── Authentication: Clerk ───────────────────────────────────────────────────
# Clerk owns credentials, email verification, sessions and MFA. Get both keys
# from the Clerk dashboard -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Svix signing secret for POST /api/webhooks/clerk. Create the endpoint under
# Clerk -> Webhooks and subscribe to user.created, user.updated, user.deleted.
# Without it the webhook rejects every request; the session path still
# provisions users on first sign-in, so this is optional in development.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Canonical public origin, no trailing slash. The payment gateway posts the
# payer back to absolute URLs built from this, so a wrong value strands a
# completed payment on a dead callback. Required in production.
APP_URL=http://localhost:3000

# Comma-separated emails with admin access.
ADMIN_EMAILS=

# ─── Payments: SSLCommerz ────────────────────────────────────────────────────
# Sandbox credentials come from https://developer.sslcommerz.com. Checkout
# returns 503 until both are set; nothing else in the app is affected.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# "false" switches to the live gateway (securepay.sslcommerz.com).
# Anything else - including unset - stays on sandbox.
SSLCOMMERZ_SANDBOX=true

# Register the IPN URL in the SSLCommerz merchant panel:
#   <APP_URL>/api/payments/sslcommerz/ipn
# It is the authoritative notification; the browser return URL only mirrors it.

# ─── Notifications (optional) ────────────────────────────────────────────────
# Deadline reminders leave the app through these. With none configured the
# scheduler still runs and records every send as "skipped", so nothing breaks
# in development.

# Email: Resend. NOTIFY_EMAIL_FROM must be a verified sender on that account.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=Polaris <deadlines@yourdomain.com>

# SMS: any HTTP gateway (SSL Wireless, Banglalink, Robi all expose one).
# Reminders are truncated to a single 160-character segment.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=Polaris

# ─── Rate limiting: Upstash Redis ────────────────────────────────────────────
# Shared sliding-window store. Without these the limiter falls back to a
# per-process map, which on serverless means the budget is multiplied by the
# number of warm instances - i.e. effectively no limit.
#
# Scopes that front a metered model call (chat, planning, action-lab, exam-ai,
# essay, interpreter, partner-refresh, public-demo) FAIL CLOSED when these are
# set but Redis is unreachable: a 503 is cheaper than an unbounded model bill.
# Leave them unset in development to use the in-process fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret for POST-less scheduled routes. Vercel Cron sends it as
# `Authorization: Bearer <value>`. Without it /api/cron/* refuses to run at all.
CRON_SECRET=

# ─── Analytics (optional) ────────────────────────────────────────────────────
# Any PostHog-compatible capture endpoint. Unset means track() is a no-op in
# production and logs to the console in development.
NEXT_PUBLIC_ANALYTICS_HOST=
NEXT_PUBLIC_ANALYTICS_KEY=
