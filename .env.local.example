# Google AI Studio key. It is held server-side and only the Gemma 4 ids
# whitelisted in lib/llm/gemma.ts can be selected.
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional non-generative web retrieval for Research mode.
TAVILY_API_KEY=

# Retrieval (lib/rag). Embeddings reuse GEMMA_API_KEY - an embedding model is
# a non-generative retriever, Gemma 4 is still the only model that writes text.
# Set RAG_EMBEDDINGS=off to fall back to BM25-only retrieval.
RAG_EMBEDDINGS=
# Embedding model + truncated dimensionality. Changing either invalidates the
# stored vectors: re-run `npm run rag:ingest -- --force` afterwards.
RAG_EMBED_MODEL=gemini-embedding-001
RAG_EMBED_DIM=768
# Set to "off" to skip the Gemma call that rewrites follow-up questions into
# standalone retrieval queries.
RAG_QUERY_REWRITE=
# Weight of the dense rank list against the lexical one during fusion.
# Retune with `npm run rag:eval` if you change the corpus or the embedder.
RAG_VECTOR_WEIGHT=1.6
# LLM reranking of retrieved passages. Costs one extra model call per turn, so
# it is off unless `npm run rag:eval -- --rerank` shows it earns that latency.
RAG_RERANK=
# Set to "off" to disable the second retrieval pass. It fires when the first
# pass returns too little, or when its best passage scores below the
# similarity threshold below - i.e. when retrieval found nothing relevant.
RAG_SECOND_PASS=
RAG_SECOND_PASS_THRESHOLD=0.6
# Requests-per-minute budget for the batch eval harnesses only. Production
# request paths are never queued - they fail fast or fall back instead.
RAG_EVAL_RPM=12

# MongoDB connection string. The public /demo route works without MongoDB;
# authenticated workspace features require it.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Authentication
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Comma-separated emails with admin access.
ADMIN_EMAILS=

# Optional subscriptions
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_ELITE=
