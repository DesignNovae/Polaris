# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---- Dependencies ----
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Next.js ----
/.next/
/out/
/build
next-env.d.ts

# ---- Testing / coverage ----
/coverage

# ---- TypeScript ----
*.tsbuildinfo

# ---- Environment variables & Secrets ----
.env
.env.*
!.env.example
!.env.local.example
test-db-hardcoded.js

# ---- Vercel ----
.vercel

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Editor / tooling ----
.vscode/
.idea/

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Certificates ----
*.pem

# ---- Local recordings / large media ----
*.mkv
*.mp4
*.webm
*.mov

# ---- Local tooling / generated artifacts ----
/.cache/
/.turbo/
/.history/
/playwright-report/
/test-results/
/artifacts/
/tmp/
/.local-logs/
*.zip
*.bak
*.tmp

# ---- Agents ----
.agents/
test-db-hardcoded.js
